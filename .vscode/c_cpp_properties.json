{
  "configurations": [
    {
      "name": "mykernel-i386-c",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src/drivers/dx",
        "${workspaceFolder}/src/drivers/display/bga",
        "${workspaceFolder}/src/drivers/display/virtio_gpu"
      ],
      "defines": [
        "__i386__",
        "__freestanding__"
      ],
      "compilerPath": "/opt/homebrew/opt/llvm/bin/clang",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x86",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/userspace"
        ],
        "limitSymbolsToIncludedHeaders": false
      },
      "compilerArgs": [
        "--target=i386-none-elf",
        "-ffreestanding",
        "-fno-builtin",
        "-fno-stack-protector",
        "-fno-pic",
        "-nostdlib",
        "-I${workspaceFolder}/include"
      ]
    }
  ],
  "version": 4
}
