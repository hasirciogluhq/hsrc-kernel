# Kernel C sources / headers
CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=i386-none-elf
    - -ffreestanding
    - -fno-builtin
    - -fno-stack-protector
    - -fno-pic
    - -nostdlib
    - -Iinclude
    - -Isrc/drivers/dx
    - -Isrc/drivers/display/bga
    - -Isrc/drivers/display/virtio_gpu
  Remove:
    - -m32
    - -m64

---

# C translation units — never feed -std=c++*
If:
  PathMatch: .*\.(c)$

CompileFlags:
  Add:
    - -std=c11
  Remove:
    - -std=c++.*

---

# C++ sources + headers (userspace apps/SDK and any .cpp/.hpp)
If:
  PathMatch: .*\.(cpp|cc|cxx|hpp|hxx|hh)$|include/user/.*|userspace/.*

CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=i386-none-elf
    - -std=c++17
    - -ffreestanding
    - -fno-exceptions
    - -fno-rtti
    - -fno-builtin
    - -DUSERMODE
    - -Iinclude
    - -Iuserspace/sdk/core
  Remove:
    - -m32
    - -m64
    - -std=c11
    - -std=gnu11
    - -std=c99
    - -std=gnu99

Index:
  Background: Build
