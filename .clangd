# Shared freestanding flags (no -std here — language-specific blocks below)
CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=i386-none-elf
    - -ffreestanding
    - -fno-builtin
    - -fno-stack-protector
    - -fno-pic
    - -nostdlib
    - -Iinclude
    - -Isrc/drivers/dx
    - -Isrc/drivers/display/bga
    - -Isrc/drivers/display/virtio_gpu
  Remove:
    - -m32
    - -m64

---

# Pure C sources
If:
  PathMatch: .*\.c$

CompileFlags:
  Add:
    - -std=c11
  Remove:
    - -std=c++.*

---

# C headers (kernel + include/user/*.h like exec.h) — never -std=c++*
If:
  PathMatch: .*\.h$

CompileFlags:
  Add:
    - -std=c11
    - -DUSERMODE
    - -Iuserspace/sdk/core
  Remove:
    - -std=c++.*
    - -std=gnu\+\+.*
    - -fno-exceptions
    - -fno-rtti

---

# C++ sources + C++ headers only (.hpp etc.), not .h
If:
  PathMatch: .*\.(cpp|cc|cxx|hpp|hxx|hh)$

CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=i386-none-elf
    - -std=c++17
    - -ffreestanding
    - -fno-exceptions
    - -fno-rtti
    - -fno-builtin
    - -DUSERMODE
    - -Iinclude
    - -Iuserspace/sdk/core
  Remove:
    - -m32
    - -m64
    - -std=c11
    - -std=gnu11
    - -std=c99
    - -std=gnu99

Index:
  Background: Build
